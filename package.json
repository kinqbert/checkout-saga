{
  "name": "checkout-saga",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "dev": "pnpm build && pnpm -r --parallel dev",
    "infra-up": "docker compose -f infra/docker-compose.yaml up -d db nats",
    "e2e": "node scripts/e2e.mjs",
    "docker-up": "docker compose -f infra/docker-compose.yaml --profile app up -d --build --wait",
    "docker-down": "docker compose -f infra/docker-compose.yaml --profile app down",
    "docker-reset": "docker compose -f infra/docker-compose.yaml --profile app down -v",
    "docker-logs": "docker compose -f infra/docker-compose.yaml --profile app logs -f"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^7.0.2"
  }
}
