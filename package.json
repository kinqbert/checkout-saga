{
  "name": "checkout-saga",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "build": "pnpm -r build",
    "docker-up": "docker compose -f ./infra/docker-compose.yaml up -d",
    "docker-down": "docker compose -f infra/docker-compose.yaml down -v",
    "docker-reset": "pnpm docker-down && pnpm docker-up"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^7.0.2"
  }
}
