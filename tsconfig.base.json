{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,

    "lib": ["ES2023"],
    "types": ["node"],

    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true
  }
}
